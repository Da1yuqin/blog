---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <author><name>{{ site.author.name | default: site.title | xml_escape }}</name></author>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ '/' | absolute_url | xml_escape }}"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  {% for post in site.posts %}
  <entry>
    <title>{{ post.title | xml_escape }}</title>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <link href="{{ post.url | absolute_url | xml_escape }}"/>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <summary>{{ post.excerpt | strip_html | xml_escape }}</summary>
  </entry>
  {% endfor %}
</feed>
