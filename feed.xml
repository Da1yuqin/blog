---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
{% assign public_feed_url = site.blog_access_api | append: '/api/blog/feed' %}
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.title | xml_escape }}</title>
  <id>{{ '/feed.xml' | absolute_url | xml_escape }}</id>
  <link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/atom+xml"/>
  <link href="{{ public_feed_url | xml_escape }}" rel="alternate" type="application/atom+xml"/>
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <entry>
    <title>公开文章订阅地址已更新</title>
    <id>{{ '/feed.xml#public-subscription' | absolute_url | xml_escape }}</id>
    <link href="{{ public_feed_url | xml_escape }}"/>
    <updated>{{ site.time | date_to_xmlschema }}</updated>
    <summary>请将订阅地址更新为此条目链接的新地址。新订阅会随文章公开状态更新，只收录公开文章。</summary>
    <content type="text">{{ public_feed_url | xml_escape }}</content>
  </entry>
</feed>
